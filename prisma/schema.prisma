// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model for authentication
model User {
  id                String    @id @default(uuid())
  email             String    @unique
  emailVerified     DateTime?
  password          String?   // For email/password auth
  name              String?
  image             String?
  
  // User profile fields
  role              UserRole  @default(USER)
  industry          String?
  experienceLevel   String?
  goals             String[]  @default([])
  
  // Subscription info
  subscriptionTier    SubscriptionTier @default(FREE)
  subscriptionStatus  SubscriptionStatus @default(ACTIVE)
  subscriptionExpiresAt DateTime?
  
  // Usage tracking
  portfolioCount      Int @default(0)
  aiRequestsCount     Int @default(0)
  aiRequestsResetAt   DateTime @default(now())
  
  // Preferences
  preferredLanguage   String @default("en")
  preferredCurrency   String @default("USD")
  timezone            String @default("UTC")
  
  // Timestamps
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  
  // Relations
  accounts           Account[]
  sessions           Session[]
  portfolios         Portfolio[]
  experiments        Experiment[]
  analyticsEvents    AnalyticsEvent[]
  payments           Payment[]
  referrals          Referral[]
  referredBy         Referral? @relation("ReferredUsers")
  githubIntegrations GitHubIntegration[]
  customDomains      CustomDomain[]
}

// Account model for OAuth providers
model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([provider, providerAccountId])
}

// Session model for user sessions
model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Portfolio model
model Portfolio {
  id              String   @id @default(uuid())
  userId          String
  
  // Basic information
  name            String
  title           String
  bio             String   @default("")
  tagline         String?
  avatarUrl       String?
  
  // Contact & social (stored as JSON)
  contact         Json     @default("{}")
  social          Json     @default("{}")
  
  // Professional content (stored as JSON arrays)
  experience      Json     @default("[]")
  education       Json     @default("[]")
  projects        Json     @default("[]")
  skills          Json     @default("[]")
  certifications  Json     @default("[]")
  
  // Template and customization
  template        TemplateType @default(DEVELOPER)
  customization   Json     @default("{}")
  colors          Json     @default("{}")
  fonts           Json     @default("{}")
  
  // Publishing
  status          PortfolioStatus @default(DRAFT)
  publishedAt     DateTime?
  subdomain       String?  @unique
  customDomain    String?  @unique
  
  // Analytics
  totalViews      Int      @default(0)
  viewsLast6h     Int      @default(0)
  uniqueVisitors  Int      @default(0)
  
  // SEO
  seoTitle        String?
  seoDescription  String?
  seoKeywords     String[]
  ogImage         String?
  
  // AI enhancements
  aiEnhanced      Boolean  @default(false)
  aiTone          EnhancementTone @default(PROFESSIONAL)
  aiLength        EnhancementLength @default(CONCISE)
  
  // Timestamps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  variants        PortfolioVariant[]
  views           PortfolioView[]
}

// Portfolio variants for A/B testing
model PortfolioVariant {
  id              String   @id @default(uuid())
  portfolioId     String
  name            String
  description     String?
  
  // Variant content
  content         Json
  customization   Json
  
  // Performance metrics
  views           Int      @default(0)
  conversions     Int      @default(0)
  conversionRate  Float    @default(0)
  
  isActive        Boolean  @default(true)
  isControl       Boolean  @default(false)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  portfolio       Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
}

// Portfolio view tracking
model PortfolioView {
  id              String   @id @default(uuid())
  portfolioId     String
  
  // Visitor info
  visitorId       String?
  ipAddress       String?
  userAgent       String?
  referrer        String?
  
  // Location
  country         String?
  city            String?
  region          String?
  
  // Session info
  sessionId       String?
  duration        Int?     // in seconds
  
  createdAt       DateTime @default(now())
  
  portfolio       Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
}

// Experiments for A/B testing
model Experiment {
  id              String   @id @default(uuid())
  userId          String?
  
  name            String
  description     String?
  type            ExperimentType
  status          ExperimentStatus @default(DRAFT)
  
  // Targeting
  targetAudience  Json     @default("{}")
  
  // Variants
  variants        Json     @default("[]")
  
  // Metrics
  metrics         Json     @default("{}")
  results         Json     @default("{}")
  
  startedAt       DateTime?
  endedAt         DateTime?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// Analytics events
model AnalyticsEvent {
  id              String   @id @default(uuid())
  userId          String?
  
  eventType       String
  eventName       String
  properties      Json     @default("{}")
  
  // Context
  sessionId       String?
  pageUrl         String?
  referrer        String?
  userAgent       String?
  ipAddress       String?
  
  createdAt       DateTime @default(now())
  
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// Payment records
model Payment {
  id              String   @id @default(uuid())
  userId          String
  
  stripePaymentId String?  @unique
  stripeCustomerId String?
  
  amount          Int      // in cents
  currency        String   @default("USD")
  status          PaymentStatus
  
  description     String?
  metadata        Json     @default("{}")
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Referral system
model Referral {
  id              String   @id @default(uuid())
  referrerId      String
  referredId      String?  @unique
  
  code            String   @unique
  status          ReferralStatus @default(PENDING)
  
  // Rewards
  rewardAmount    Int?     // in cents
  rewardType      RewardType @default(CREDIT)
  rewardPaidAt    DateTime?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  referrer        User     @relation(fields: [referrerId], references: [id], onDelete: Cascade)
  referred        User?    @relation("ReferredUsers", fields: [referredId], references: [id], onDelete: SetNull)
}

// Revenue analytics
model RevenueAnalytics {
  id              String   @id @default(uuid())
  
  periodStart     DateTime
  periodEnd       DateTime
  
  totalRevenue    Int      // in cents
  transactionCount Int
  
  metrics         Json     // detailed breakdown
  
  createdAt       DateTime @default(now())
}

// Funnel events for conversion tracking
model FunnelEvent {
  id              String   @id @default(uuid())
  
  eventType       FunnelEventType
  userId          String?
  sessionId       String?
  
  metadata        Json     @default("{}")
  
  createdAt       DateTime @default(now())
}

// Enums
enum SubscriptionTier {
  FREE
  PRO
  BUSINESS
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  CANCELLED
  EXPIRED
}

enum TemplateType {
  DEVELOPER
  DESIGNER
  CONSULTANT
  EDUCATOR
  CREATIVE
  BUSINESS
}

enum PortfolioStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EnhancementTone {
  PROFESSIONAL
  CASUAL
  CREATIVE
}

enum EnhancementLength {
  CONCISE
  DETAILED
  COMPREHENSIVE
}

enum ExperimentType {
  AB_TEST
  MULTIVARIATE
  FEATURE_FLAG
}

enum ExperimentStatus {
  DRAFT
  RUNNING
  PAUSED
  COMPLETED
  ARCHIVED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
}

enum ReferralStatus {
  PENDING
  ACTIVE
  COMPLETED
  EXPIRED
  CANCELLED
}

enum RewardType {
  CREDIT
  DISCOUNT
  SUBSCRIPTION
}

enum FunnelEventType {
  PAGE_VIEW
  SIGNUP
  PORTFOLIO_CREATED
  PORTFOLIO_PUBLISHED
  PAYMENT_COMPLETED
}

enum UserRole {
  USER
  ADMIN
  MODERATOR
}

enum DomainStatus {
  PENDING
  VERIFIED
  FAILED
}

// GitHub Integration
model GitHubIntegration {
  id              String   @id @default(uuid())
  userId          String
  
  accessToken     String
  refreshToken    String?
  expiresAt       DateTime?
  
  githubUserId    String
  githubUsername  String
  
  lastSyncedAt    DateTime?
  isActive        Boolean  @default(true)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId])
}

// Custom Domain
model CustomDomain {
  id                    String   @id @default(uuid())
  userId                String
  domain                String   @unique
  
  verificationToken     String
  verificationStatus    DomainStatus @default(PENDING)
  dnsConfigured         Boolean  @default(false)
  verifiedAt            DateTime?
  dnsLastCheckedAt      DateTime?
  verificationAttempts  Int      @default(0)
  lastVerificationAt    DateTime?
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  verificationLogs      DomainVerificationLog[]
}

// Domain Verification Log
model DomainVerificationLog {
  id               String   @id @default(uuid())
  domainId         String
  
  verificationType String
  status           String
  dnsRecords       Json?
  expectedValue    String?
  actualValue      String?
  errorCode        String?
  errorMessage     String?
  
  createdAt        DateTime @default(now())
  
  domain           CustomDomain @relation(fields: [domainId], references: [id], onDelete: Cascade)
}

// Landing Page Experiments
model LandingPageExperiment {
  id                  String   @id @default(uuid())
  name                String
  description         String?
  hypothesis          String?
  status              String   @default("draft")
  traffic_percentage  Int      @default(100)
  target_audience     Json     @default("{}")
  primary_metric      String
  secondary_metrics   String[] @default([])
  start_date          String?
  end_date            String?
  created_by          String
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  
  variants            LandingPageVariant[]
}

// Landing Page Variants
model LandingPageVariant {
  id                    String  @id @default(uuid())
  experimentId          String  @map("experiment_id")
  name                  String
  description           String?
  isControl             Boolean @map("is_control") @default(false)
  trafficPercentage     Int     @map("traffic_percentage")
  components            Json    @default("[]")
  themeOverrides        Json    @map("theme_overrides") @default("{}")
  visitorCount          Int     @map("visitor_count") @default(0)
  conversionCount       Int     @map("conversion_count") @default(0)
  conversionRate        Float   @map("conversion_rate") @default(0)
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  experiment            LandingPageExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
}

// User Activity
model UserActivity {
  id           String   @id @default(uuid())
  userId       String
  action       String
  resource     String?
  metadata     Json     @default("{}")
  
  createdAt    DateTime @default(now())
}

// AI Usage Log
model AIUsageLog {
  id           String   @id @default(uuid())
  userId       String
  model        String
  tokens       Int
  cost         Float?
  action       String
  
  createdAt    DateTime @default(now())
}

// Referral Reward
model ReferralReward {
  id           String   @id @default(uuid())
  userId       String
  amount       Int
  type         String
  status       String   @default("pending")
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Subscription
model Subscription {
  id           String   @id @default(uuid())
  userId       String
  tier         String
  status       String
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Landing Component Library
model LandingComponentLibrary {
  id          String   @id @default(uuid())
  name        String
  components  Json     @default("[]")
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Experiment Template
model ExperimentTemplate {
  id          String   @id @default(uuid())
  name        String
  description String?
  template    Json     @default("{}")
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}